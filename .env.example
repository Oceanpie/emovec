# ── Embedding API Keys ──────────────────────────────
# Go service reads these via ${VAR} in config.yaml.
# Python scripts load them directly via load_env().

# Self-hosted embedding endpoint
EMBEDDING_SELFHOST_KEY=sk-your-key-here
EMBEDDING_SELFHOST_URL=https://your-selfhost-endpoint/v1

# Local OpenAI-compatible endpoint (Ollama, vLLM, LocalAI, etc.)
EMBEDDING_LOCAL_KEY=not-needed
EMBEDDING_LOCAL_URL=http://localhost:8000/v1
